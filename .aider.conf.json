{
    "model": "anthropic/claude-3.5-sonnet",
    "editor": "vim",
    "watch_files": true,
    "apply_diff": true,
    "auto_commits": false,
    "use_gitignore": true,
    "respect_editor_config": true,
    "rules": {
        "only_edit_explicit_files": true,
        "never_modify_unlisted_files": true,
        "never_create_files_unless_explicit": true,
        "never_rename_files_unless_explicit": true,
        "never_delete_files_unless_explicit": true,
        "never_rewrite_entire_files": true,
        "minimal_diffs": true
    },
    "prompts": {
        "prepend": [
            "Follow prompts/contract.md.",
            "Follow prompts/workflow.md.",
            "Follow prompts/conventions.md.",
            "Follow prompts/common/02-universal-rules.md.",
            "Follow tools/aider/aider-rules.md."
        ]
    }
}